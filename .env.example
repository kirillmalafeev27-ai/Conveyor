# Server-only. Add this as a runtime secret; never expose it through NEXT_PUBLIC_*.
AITUNNEL_API_KEY=
AITUNNEL_MODEL=gpt-5.4
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Optional: listening drills speak through ElevenLabs when this key is set and
# fall back to the browser voice when it is not.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_TIMEOUT_MS=30000
TTS_CACHE_LIMIT=180

# Optional tuning.
QUESTION_GENERATION_TIMEOUT_MS=45000
QUESTION_CACHE_TTL_MS=1800000
QUESTION_CACHE_LIMIT=96
QUESTION_GENERATION_CONCURRENCY=4
QUESTION_FAILURE_COOLDOWN_MS=15000
RECALL_EVALUATION_TIMEOUT_MS=8000
RECALL_EVALUATION_CONCURRENCY=6
